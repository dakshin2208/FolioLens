# Copy to .env and fill in. Never commit .env. Never put real keys in this file.

ENVIRONMENT=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
POSTGRES_PASSWORD=foliolens-local
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Storage: "local" (development) or "s3" (production, uses the EC2 instance's IAM role)
STORAGE_BACKEND=local
# S3_BUCKET=foliolens-uploads-yourname

# Benchmark index symbol, as loaded with `cli load-index --symbol ...`
BENCHMARK_SYMBOL=NIFTY50TRI

# AI explanations (optional). LLM_PROVIDER: none | openai | azure_openai | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
# openai / anthropic: the model ID.  azure_openai: your DEPLOYMENT name.
LLM_MODEL=
# azure_openai only: your resource endpoint, e.g. https://<resource>.openai.azure.com/
LLM_ENDPOINT=
# azure_openai only: API version
LLM_API_VERSION=2024-10-21
